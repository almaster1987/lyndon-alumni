# Cloudflare Pages headers — VTSU Lyndon Alumni Council
# Cloudflare ignores netlify.toml, so the security + cache rules are mirrored here.
# Syntax: a path pattern on its own line, followed by indented "Header: value" lines.

/*
  Content-Security-Policy: frame-ancestors 'self' https://lataille-command-center.pages.dev
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
